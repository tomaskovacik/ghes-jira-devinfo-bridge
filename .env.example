# --- GitHub Enterprise Server (read-only) ---
GHES_BASE_URL=https://ghe.example.com
# GHES_API_URL=https://ghe.example.com/api/v3
GHES_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# Default owner. Bare names in GHES_REPOS are prefixed with it; on its own it
# means "discover every non-archived repo in this org".
GHES_ORG=octo
# Explicit repos: bare names use GHES_ORG, "owner/name" entries are used as-is.
# Leave empty to sync the whole org.
GHES_REPOS=api,web
# Discover additional orgs (each entry is a full org login).
# GHES_ORGS=other-org

# --- Jira Cloud (write-only, OAuth 2.0 client credentials) ---
JIRA_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
JIRA_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# Provide the cloud id directly, or the site URL to resolve it once.
JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000
# JIRA_SITE_URL=https://your-site.atlassian.net

# --- Sync behaviour ---
# Restrict issue-key detection to these project keys (comma-separated). Strongly
# recommended: avoids false positives like UTF-8, SHA-1, ISO-8601, CVE-2021.
JIRA_PROJECT_KEYS=PROJ
# Ignored when JIRA_PROJECT_KEYS is set.
# JIRA_ISSUE_KEY_REGEX=\b[A-Z][A-Z0-9]{1,9}-\d+\b
SYNC_INTERVAL_SECONDS=1800
SYNC_LOOKBACK_DAYS=14
SYNC_INCLUDE_PRS=true
SYNC_PREVENT_TRANSITIONS=true
# Only sync branches whose name contains an issue key (plus the default branch).
SYNC_KEYED_BRANCHES_ONLY=false
# Only sync the default branch. Cheapest option for repos with hundreds of
# unkeyed branches where issue keys live in commit messages.
SYNC_DEFAULT_BRANCH_ONLY=false
# Skip branches by fnmatch glob (comma-separated), e.g. renovate/*,dependabot/*
GHES_BRANCH_EXCLUDE=
# Parallel GHES requests per repo (branch fetches). 1 = serial.
SYNC_CONCURRENCY=8
# Max commits per devinfo bulk POST. 400 is the Jira spec ceiling (values above
# are clamped); 0 = never split. Real syncs are almost always < 400 so this
# rarely fires.
SYNC_PUSH_CHUNK=400
# Send operationType=BACKFILL the first time a repo is synced (higher rate-limit
# budget, correct semantics for indexing history).
SYNC_BACKFILL_FIRST_SIGHT=true
# Issue linkage on entities. Jira rejects issueKeys + associations on one entity
# (mutually exclusive). issueKeys (default) is what every devinfo client ships;
# set JIRA_SEND_ISSUE_KEYS=false to link via associations[{issueIdOrKeys}] instead.
JIRA_SEND_ISSUE_KEYS=true
JIRA_SEND_ASSOCIATIONS=true
# Per-entity cap on issueKeys + association values (Jira rejects above 500).
JIRA_ISSUE_KEY_CAP=500
# Log every commit/branch/PR being sent to Jira, one per line (works in dry and
# wet runs). Same format as `inspect --full`.
SYNC_LOG_ENTITIES=false
# Use the GraphQL API to scan branches: ~3 calls per repo instead of ~1 per
# branch, and only branches with a commit since the lookback are processed.
# No dependence on the default branch. Needs GraphQL enabled on the instance.
GHES_USE_GRAPHQL=false

# --- Runtime ---
STATE_PATH=/data/state.json
DRY_RUN=false
LOG_LEVEL=INFO
LOG_FORMAT=text
HTTP_TIMEOUT=30
MAX_RETRIES=4
